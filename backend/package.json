{
  "name": "aaft-lms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AAFT Enterprise LMS — Backend monorepo (Nginx+Lua gateway + 5 services + shared packages)",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "prisma:generate": "npm run prisma:generate -w @aaft/db-lib",
    "prisma:migrate:dev": "npm run prisma:migrate:dev -w @aaft/db-lib",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w @aaft/db-lib",
    "prisma:studio": "npm run prisma:studio -w @aaft/db-lib",
    "seed": "npm run seed -w @aaft/db-lib",
    "dev:auth": "npm run dev -w @aaft/auth-service",
    "dev:admin": "npm run dev -w @aaft/admin-service",
    "dev:instructor": "npm run dev -w @aaft/instructor-service",
    "dev:student": "npm run dev -w @aaft/student-service",
    "dev:public": "npm run dev -w @aaft/public-service",
    "dev": "concurrently -k -n auth,admin,instructor,student,public -c blue,magenta,yellow,green,cyan \"npm:dev:auth\" \"npm:dev:admin\" \"npm:dev:instructor\" \"npm:dev:student\" \"npm:dev:public\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:rebuild": "docker-compose down && docker-compose up -d --build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
