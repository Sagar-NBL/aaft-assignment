# =====================================================================
# AAFT LMS Backend — Environment Variables
# Copy this file to .env and adjust values as needed.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=aaft
POSTGRES_PASSWORD=aaft_secret
POSTGRES_DB=aaft_lms
POSTGRES_PORT=5432

# Connection string used by Prisma (db-lib + services)
# Inside docker network the host is 'postgres'; from host machine use 'localhost'
DATABASE_URL=postgresql://aaft:aaft_secret@postgres:5432/aaft_lms?schema=public

# ---------------------------------------------------------------------
# Redis (bonus — caching + rate limit)
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------------------------------------------------------------------
# JWT (used by auth-service to sign, gateway to verify)
# ---------------------------------------------------------------------
JWT_SECRET=change-me-in-production-please-make-it-long-and-random
JWT_REFRESH_SECRET=change-me-refresh-in-production-different-from-access
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ISSUER=aaft-lms

# ---------------------------------------------------------------------
# bcrypt
# ---------------------------------------------------------------------
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------
# Gateway (Nginx + Lua) — externally exposed
# ---------------------------------------------------------------------
GATEWAY_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------
# Service ports (internal — only reachable inside docker network)
# ---------------------------------------------------------------------
AUTH_SERVICE_PORT=4001
ADMIN_SERVICE_PORT=4002
INSTRUCTOR_SERVICE_PORT=4003
STUDENT_SERVICE_PORT=4004
PUBLIC_SERVICE_PORT=4005

# ---------------------------------------------------------------------
# Seed defaults (used by seed script in db-lib)
# ---------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@aaft.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Avery Admin

SEED_STUDENT_EMAIL=student@aaft.com
SEED_STUDENT_PASSWORD=Student@123
SEED_STUDENT_NAME=Jordan Miles

SEED_INSTRUCTOR_EMAIL=instructor@aaft.com
SEED_INSTRUCTOR_PASSWORD=Instructor@123
SEED_INSTRUCTOR_NAME=Ivy Instructor

# ---------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------
LOG_LEVEL=info
NODE_ENV=development
