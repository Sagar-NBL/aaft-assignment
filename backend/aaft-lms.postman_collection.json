          }
        },
        {
          "name": "Archive course",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/admin/courses/{{courseId}}/archive", "host": ["{{baseUrl}}"], "path": ["admin", "courses", "{{courseId}}", "archive"] }
          }
        }
      ]
    },
    {
      "name": "Instructor (Part B)",
      "item": [
        {
          "name": "List own courses",
