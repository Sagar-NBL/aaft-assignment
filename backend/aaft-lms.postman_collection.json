            }
          }
        },
        {
          "name": "Run progress (for instructor's runs)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/instructor/course-runs/{{courseRunId}}/progress", "host": ["{{baseUrl}}"], "path": ["instructor", "course-runs", "{{courseRunId}}", "progress"] }
          }
        }
      ]
    },
    {
      "name": "Student",
      "item": [
        {
          "name": "Enrolled courses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) {",
                  "    pm.collectionVariables.set('courseId', json.items[0].id);",
                  "    if (json.items[0].lessons && json.items[0].lessons.length > 0) {",
                  "        pm.collectionVariables.set('lessonId', json.items[0].lessons[0].id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/student/courses?status=all",
              "host": ["{{baseUrl}}"], "path": ["student", "courses"],
              "query": [
                { "key": "status", "value": "all", "description": "all | not_started | in_progress | completed" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Course detail + lessons",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/student/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["student", "courses", "{{courseId}}"] }
          }
        },
        {
          "name": "Update video progress (90% rule)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/student/progress", "host": ["{{baseUrl}}"], "path": ["student", "progress"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoId\": \"{{lessonId}}\",\n  \"courseId\": \"{{courseId}}\",\n  \"lastWatched\": 650,\n  \"percentage\": 92,\n  \"duration\": 720,\n  \"watchedSegments\": [[0, 650]]\n}"
            }
          }
        },
        {
          "name": "Course progress",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/student/progress/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["student", "progress", "{{courseId}}"] }
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/student/dashboard", "host": ["{{baseUrl}}"], "path": ["student", "dashboard"] }
          }
        },
        {
          "name": "Self-enroll (Part B)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/student/enroll", "host": ["{{baseUrl}}"], "path": ["student", "enroll"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseRunId\": \"{{courseRunId}}\"\n}"
            }
          }
        },
        {
          "name": "My enrollments (Part B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) {",
                  "    pm.collectionVariables.set('enrollmentId', json.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/student/enrollments", "host": ["{{baseUrl}}"], "path": ["student", "enrollments"] }
          }
        },
        {
          "name": "Enrollment content (Part B)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/student/enrollments/{{enrollmentId}}/content", "host": ["{{baseUrl}}"], "path": ["student", "enrollments", "{{enrollmentId}}", "content"] }
          }
        },
        {
          "name": "Submit quiz attempt (Part B)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/student/attempts", "host": ["{{baseUrl}}"], "path": ["student", "attempts"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quizId\": \"{{quizId}}\",\n  \"enrollmentId\": \"{{enrollmentId}}\",\n  \"answers\": {\n    \"QUESTION_ID_1\": [\"CORRECT_OPTION_ID_1\"]\n  }\n}"
            }
          }
        },
        {
          "name": "Grades (Part B)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/student/grades/{{enrollmentId}}", "host": ["{{baseUrl}}"], "path": ["student", "grades", "{{enrollmentId}}"] }
          }
        },
        {
          "name": "My certificates (Part B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) {",
                  "    pm.collectionVariables.set('certificateCode', json.items[0].verificationCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/student/certificates", "host": ["{{baseUrl}}"], "path": ["student", "certificates"] }
          }
        },
        {
          "name": "Unenroll (Part B)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/student/enrollments/{{enrollmentId}}", "host": ["{{baseUrl}}"], "path": ["student", "enrollments", "{{enrollmentId}}"] }
          }
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "Verify certificate (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/certificates/{{certificateCode}}", "host": ["{{baseUrl}}"], "path": ["certificates", "{{certificateCode}}"] }
          }
        },
        {
          "name": "Gateway health (no auth)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "http://localhost:3001/_health", "host": ["http://localhost:3001"], "path": ["_health"] }
          }
        }
      ]
    }
  ]
}
