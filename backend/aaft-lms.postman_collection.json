          }
        },
        {
          "name": "Delete run (blocks if enrolled)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/admin/course-runs/{{courseRunId}}", "host": ["{{baseUrl}}"], "path": ["admin", "course-runs", "{{courseRunId}}"] }
