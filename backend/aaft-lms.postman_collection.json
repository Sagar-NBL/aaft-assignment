{
  "info": {
    "name": "AAFT LMS Backend",
    "description": "Complete API collection for the AAFT LMS backend.\n\n## Setup\n1. Import this collection in Postman\n2. The collection has variables — see the 'Variables' tab\n3. Run requests in this order:\n   - **Auth → Login (Admin)** first → token gets auto-saved\n   - Then any Admin endpoint\n   - For student endpoints: run **Auth → Login (Student)** first\n   - For instructor: **Auth → Login (Instructor)** first\n\n## Demo Accounts\n- admin@aaft.com / Admin@123\n- instructor@aaft.com / Instructor@123\n- student@aaft.com / Student@123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "courseId", "value": "", "type": "string" },
    { "key": "studentId", "value": "", "type": "string" },
    { "key": "lessonId", "value": "", "type": "string" },
    { "key": "enrollmentId", "value": "", "type": "string" },
    { "key": "courseRunId", "value": "", "type": "string" },
    { "key": "quizId", "value": "", "type": "string" },
    { "key": "certificateCode", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('✓ Admin token saved');",
                  "}",
                  "if (json.user) {",
                  "    pm.collectionVariables.set('userId', json.user.id);",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Has token + user', () => {",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json).to.have.property('user');",
                  "    pm.expect(json.user.role).to.eql('admin');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@aaft.com\",\n  \"password\": \"Admin@123\"\n}"
            }
          }
        },
        {
          "name": "Login (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('userId', json.user.id);",
                  "    console.log('✓ Student token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@aaft.com\",\n  \"password\": \"Student@123\"\n}"
            }
          }
        },
        {
          "name": "Login (Instructor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('userId', json.user.id);",
                  "    console.log('✓ Instructor token saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"instructor@aaft.com\",\n  \"password\": \"Instructor@123\"\n}"
            }
          }
        },
        {
          "name": "Register (Part B)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.user@example.com\",\n  \"password\": \"NewUser@123\",\n  \"name\": \"New User\",\n  \"role\": \"student\"\n}"
            }
          }
        },
        {
          "name": "Refresh (Part B)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout (Part B)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin — Students",
      "item": [
        {
          "name": "List students (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) {",
                  "    pm.collectionVariables.set('studentId', json.items[0].id);",
                  "    console.log('✓ studentId saved:', json.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/students?page=1&limit=10&sort=name",
              "host": ["{{baseUrl}}"], "path": ["admin", "students"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "name" },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get student by id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{studentId}}"] }
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/students", "host": ["{{baseUrl}}"], "path": ["admin", "students"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ravi Kumar\",\n  \"email\": \"ravi.kumar@example.com\"\n}"
            }
          }
        },
        {
          "name": "Update student",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{studentId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Miles (updated)\"\n}"
            }
          }
        },
        {
          "name": "Delete student (soft)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/admin/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "students", "{{studentId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin — Courses & Lessons",
      "item": [
        {
          "name": "List courses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) {",
                  "    pm.collectionVariables.set('courseId', json.items[0].id);",
                  "    if (json.items[0].lessons && json.items[0].lessons.length > 0) {",
                  "        pm.collectionVariables.set('lessonId', json.items[0].lessons[0].id);",
                  "    }",
                  "    console.log('✓ courseId + lessonId saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/courses", "host": ["{{baseUrl}}"], "path": ["admin", "courses"] }
          }
        },
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/courses", "host": ["{{baseUrl}}"], "path": ["admin", "courses"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Course\",\n  \"description\": \"A test course\",\n  \"thumbnail\": \"https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=800\"\n}"
            }
          }
        },
        {
          "name": "Update course",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["admin", "courses", "{{courseId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}"
            }
          }
        },
        {
          "name": "Delete course",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/admin/courses/{{courseId}}", "host": ["{{baseUrl}}"], "path": ["admin", "courses", "{{courseId}}"] }
          }
        },
        {
          "name": "Create lesson",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/courses/{{courseId}}/lessons", "host": ["{{baseUrl}}"], "path": ["admin", "courses", "{{courseId}}", "lessons"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Lesson\",\n  \"description\": \"Lesson description\",\n  \"videoUrl\": \"https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4\",\n  \"duration\": 600\n}"
            }
          }
        },
        {
          "name": "Update lesson",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/courses/{{courseId}}/lessons", "host": ["{{baseUrl}}"], "path": ["admin", "courses", "{{courseId}}", "lessons"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lessonId\": \"{{lessonId}}\",\n  \"title\": \"Updated Lesson Title\"\n}"
            }
          }
        },
        {
          "name": "Delete lesson",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/admin/courses/{{courseId}}/lessons?lessonId={{lessonId}}",
              "host": ["{{baseUrl}}"], "path": ["admin", "courses", "{{courseId}}", "lessons"],
              "query": [{ "key": "lessonId", "value": "{{lessonId}}" }]
            }
          }
        }
      ]
    },
    {
      "name": "Admin — Enrollments",
      "item": [
        {
          "name": "List enrollments (with progress)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/enrollments", "host": ["{{baseUrl}}"], "path": ["admin", "enrollments"] }
          }
        },
        {
          "name": "Bulk assign",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/enrollments", "host": ["{{baseUrl}}"], "path": ["admin", "enrollments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentIds\": [\"{{studentId}}\"],\n  \"courseIds\": [\"{{courseId}}\"]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin — Reports",
      "item": [
        {
          "name": "Overview (dashboard)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/reports/overview", "host": ["{{baseUrl}}"], "path": ["admin", "reports", "overview"] }
          }
        },
        {
          "name": "Per-student report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/admin/reports/students/{{studentId}}", "host": ["{{baseUrl}}"], "path": ["admin", "reports", "students", "{{studentId}}"] }
          }
        },
        {
          "name": "Progress report (Part B)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/reports/progress?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["admin", "reports", "progress"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "from", "value": "2025-01-01", "disabled": true },
                { "key": "to", "value": "2026-12-31", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Completions report (Part B)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/reports/completions?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["admin", "reports", "completions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Time-spent report (Part B)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/reports/time-spent?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["admin", "reports", "time-spent"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin — Users (Part B)",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/admin/users?page=1&limit=20",
              "host": ["{{baseUrl}}"], "path": ["admin", "users"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "role", "value": "instructor", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.instructor@aaft.com\",\n  \"password\": \"Pass@123456\",\n  \"name\": \"New Instructor\",\n  \"role\": \"instructor\"\n}"
            }
          }
        },
        {
          "name": "Update user (change role)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"instructor\"\n}"
            }
          }
        },
        {
          "name": "Soft delete user",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/admin/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["admin", "users", "{{userId}}"] }
          }
        }
      ]
    },
    {
      "name": "Admin — Course Runs (Part B)",
      "item": [
        {
          "name": "List runs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
